{
  "name": "classpad",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard": "node scripts/guard-private.mjs",
    "build": "tsc -b"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/guard-private.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
