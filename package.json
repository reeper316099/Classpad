{
  "name": "classpad",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b && tsc -p apps/web --noEmit && tsc -p apps/desktop --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard": "node scripts/guard-private.mjs",
    "build": "tsc -b",
    "dev:server": "tsc -b && node packages/server/dist/dev.js",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "fixtures:check-leak": "node scripts/check-fixture-leak.mjs",
    "dev": "node scripts/dev.mjs",
    "build:web": "npm run build -w @classpad/web",
    "desktop": "npm run start -w @classpad/desktop",
    "desktop:pack": "npm run pack -w @classpad/desktop",
    "desktop:dist": "npm run dist -w @classpad/desktop",
    "e2e": "npm run bundle -w @classpad/desktop && playwright test -c e2e/playwright.config.ts",
    "dev:stop": "node scripts/dev.mjs --stop"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/guard-private.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "katex": "^0.19.0",
    "zod": "3.25.76"
  }
}
